#!/usr/bin/env python3
"""Real adversarial tool experiment — run: python bin/eval-experiment"""
from effect_broker.experiment import run_all_experiments

results = run_all_experiments()
blocked = 0
for k, r in sorted(results.items()):
    status = "BLOCKED" if r.actual_blocker != "ALLOW" else "PASS(ALLOW)"
    print("  {:55s}  {}  ({})".format(r.name, status, r.actual_blocker))
    if r.actual_blocker != "ALLOW":
        blocked += 1

print()
print("{}/{} traces blocked".format(blocked, len(results)))
m4 = results.get("M4-benign-read-send")
if m4 and m4.actual_blocker == "ALLOW":
    print("M4 (benign tool): PASS — benign work is NOT blocked")
else:
    print("M4 (benign tool): WARN — benign work should ALLOW")