#!/usr/bin/env python3
"""Baseline comparison — run: python bin/eval-baseline"""
from effect_broker.baselines import run_comparison

results = run_comparison()
print()
print("  {:15s}  {:>6s}  {:>5s}".format("Baseline", "Blocked", "Total"))
print("  " + "-" * 34)
for baseline, traces in sorted(results.items(), key=lambda x: -sum(t["blocked"] for t in x[1])):
    blocked = sum(1 for t in traces if t["blocked"])
    total = len(traces)
    pct = blocked / total * 100
    marker = " <- EAC " if baseline == "ECAC" else ""
    print("  {:15s}  {:>4d}/{:>2d} ({:3.0f}%){}".format(baseline, blocked, total, pct, marker))

print()
ecac = sum(1 for t in results["ECAC"] if t["blocked"])
best = max(
    sum(1 for t in traces if t["blocked"])
    for name, traces in results.items()
    if name != "ECAC"
)
diff = ecac - best
print("ECAC blocks {}/20 traces. Next best baseline blocks {}/20.".format(ecac, best))
print("ECAC advantage: {} traces beyond all baselines.".format(diff))
print()
pact = sum(1 for t in results.get("PACT", []) if t["blocked"])
print("Kill criterion (ECAC ≥4 beyond PACT): {}".format("PASS" if ecac - pact >= 4 else "FAIL"))